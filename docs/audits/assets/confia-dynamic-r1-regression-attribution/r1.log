e ConfIA");\n    action.type = "button";\n    action.className = "primary-action";\n    panel.appendChild(action);\n    const rerun = node("button", "Executar novamente");\n    rerun.type = "button";\n    rerun.className = "secondary-action";\n    panel.appendChild(rerun);\n    const guidance = node("p");\n    panel.appendChild(guidance);\n    if (history?.acceptances?.some(item => item.revision_number === latest?.revision_number\n        && !item.accepted_revision_sha256)) {\n      panel.appendChild(node("p", "Aceite anterior sem v\xednculo de integridade. Crie e confira uma nova revis\xe3o antes da an\xe1lise.")).className = "transcription-warning";\n    }\n    const selection = node("select");\n    const selectionLabel = labeled("Hist\xf3rico das an\xe1lises", selection);\n    panel.appendChild(selectionLabel);\n    const result = node("div");\n    panel.appendChild(result);\n\n    function updateControls() {\n      action.disabled = editor.busy || editor.isDirty() || !accepted || !originalsIntact(data) || initialRuns === null || attemptState === "CONFLICT";\n      const current = runs.find(run => run.transcription_id === latest?.transcription_id && run.revision_number === latest?.revision_number);\n      rerun.hidden = !current;\n      rerun.disabled = action.disabled;\n      selection.disabled = editor.busy;\n      guidance.textContent = attemptState === "CONFLICT" ? attemptMessage\n        : !originalsIntact(data) ? "Os arquivos originais desta solu\xe7\xe3o precisam ser conferidos."\n        : !accepted ? "A transcri\xe7\xe3o precisa ser conferida antes da an\xe1lise."\n          : editor.isDirty() ? "Salve ou descarte as altera\xe7\xf5es antes de analisar a revis\xe3o conferida."\n            : "A an\xe1lise usa somente a revis\xe3o persistida e conferida. Nota e resultado s\xe3o sugest\xf5es para o professor.";\n    }\n    editor.onChange = updateControls;\n\n    function showRuns() {\n      selection.replaceChildren();\n      for (const run of runs) selection.appendChild(option(run.audit_run_id, `Revis\xe3o ${run.revision_number} \xb7 ${when(run.created_at)} \xb7 ${historicalLabel(run) || (run.status === "COMPLETED" ? "Conclu\xedda" : "N\xe3o foi poss\xedvel concluir")}`));\n      selection.value = selectedId || "";\n      selectionLabel.hidden = runs.length === 0;\n      result.replaceChildren();\n      const run = runs.find(item => item.audit_run_id === selectedId) || runs[0];\n      state.textContent = attemptState ? attemptMessage\n        : initialRuns === null ? "N\xe3o foi poss\xedvel consultar as an\xe1lises. Reabra a solu\xe7\xe3o."\n          : run ? isStale(run) ? "An\xe1lise de uma vers\xe3o anterior" : run.status === "COMPLETED" ? "\u2713 Conclu\xedda" : "N\xe3o foi poss\xedvel concluir a An\xe1lise ConfIA." : "\u25cb N\xe3o executada";\n      state.dataset.kind = attemptState || initialRuns === null || run?.status === "FAILED" ? "error"\n        : run && !isStale(run) ? "success" : "neutral";\n      if (!run) result.appendChild(node("p", "Esta solu\xe7\xe3o ainda n\xe3o foi encaminhada para an\xe1lise matem\xe1tica.")).className = "empty-state";\n      else {\n        if (attemptState || isStale(run)) result.appendChild(node("p", attemptState\n          ? `${historicalLabel(run)}. Dispon\xedvel somente como hist\xf3rico.`\n          : "Esta an\xe1lise corresponde a uma vers\xe3o anterior. Dispon\xedvel somente como hist\xf3rico.")).className = "transcription-warning";\n        if (run.source.provenance?.revision?.provider === "fake_test") result.appendChild(node("p", "An\xe1lise baseada em transcri\xe7\xe3o de teste artificial; n\xe3o \xe9 reconhecimento real do manuscrito.")).className = "transcription-warning";\n        result.appendChild(node("p", `An\xe1lise da revis\xe3o ${run.revision_number} \xb7 conferida em ${when(run.source.accepted_at)}`));\n        for (const warning of run.source.warnings || []) result.appendChild(node("p", `P\xe1gina ${warning.page_index + 1}: ${warning.message}`)).classNa