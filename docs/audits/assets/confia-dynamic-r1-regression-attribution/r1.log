tions.analyzeAgain);\n    const report = document.createElement("div");\n    targetPanel.appendChild(report);\n    window.ConfIAReport.render(data, report, options);\n  } else window.ConfIAReport.render(data, targetPanel, options);\n}\nconst makeBadge = (...args) => window.ConfIAReport.makeBadge(...args);\n\nfunction renderError(message, targetPanel = resultPanel) {\n  clearNode(targetPanel);\n  const panel = document.createElement("section");\n  panel.className = "error-panel";\n  appendTextElement(panel, "h2", "result-title", "N\xe3o foi poss\xedvel concluir");\n  appendTextElement(panel, "p", "summary-text", message);\n  targetPanel.appendChild(panel);\n}\n\nfunction currentProblemTitle(problemId) {\n  const problem = problems.find((item) => (item.problem_id || item.id) === problemId);\n  if (!problem) {\n    return problemId;\n  }\n  return problem.title || problem.problem_id || problem.id;\n}\n\nfunction createSubmissionButton(submission) {\n  const button = document.createElement("button");\n  button.className = "submission-row";\n  button.type = "button";\n  button.classList.toggle(\n    "is-selected",\n    selectedTeacherSubmission && selectedTeacherSubmission.id === submission.id\n  );\n\n  const name = appendTextElement(button, "strong", "", submission.student_name || "Aluno");\n  name.title = submission.student_name || "Aluno";\n  appendTextElement(button, "span", "", submission.problem_title || submission.problem_id || "Quest\xe3o");\n  appendTextElement(button, "span", "submission-date", formatDateTime(submission.submitted_at));\n  button.appendChild(makeBadge("Demonstra\xe7\xe3o textual local", "neutral"));\n\n  button.addEventListener("click", () => {\n    selectedTeacherSubmission = submission;\n    teacherDecisionMessage.textContent = "";\n    renderTeacherCorrectionEmpty();\n    renderTeacherArea();\n  });\n\n  return button;\n}\n\nfunction renderSubmissionList(target, submissions, emptyText) {\n  clearNode(target);\n  if (!submissions.length) {\n    appendTextElement(target, "p", "muted list-empty", emptyText);\n    return;\n  }\n\n  for (const submission of submissions) {\n    target.appendChild(createSubmissionButton(submission));\n  }\n}\n\nfunction renderTeacherCorrectionEmpty(text = "Selecione um envio e analise com o ConfIA.") {\n  clearNode(teacherCorrectionPanel);\n  const empty = document.createElement("div");\n  empty.className = "empty-state";\n  appendTextElement(empty, "p", "eyebrow", "Painel de corre\xe7\xe3o");\n  appendTextElement(empty, "p", "", text);\n  teacherCorrectionPanel.appendChild(empty);\n}\n\nfunction renderTeacherAnalysis(submission) {\n  const analysis = teacherAnalyses.get(submission.id);\n  teacherAuditButton.disabled = Boolean(analysis?.pending);\n  teacherAuditButton.setAttribute("aria-busy", String(Boolean(analysis?.pending)));\n  teacherAuditButton.textContent = analysis?.pending ? "Analisando\u2026" : "Analisar com ConfIA";\n  const state = analysis?.pending ? "processing" : analysis?.error ? "failed" : analysis?.data ? "completed" : "not-run";\n  teacherAnalysisStatus.dataset.analysisState = state;\n  teacherAnalysisStatus.textContent = analysis?.pending ? "An\xe1lise ConfIA: Processando"\n    : analysis?.error ? "An\xe1lise ConfIA: N\xe3o foi poss\xedvel concluir" : analysis?.data ? "An\xe1lise ConfIA: Conclu\xedda" : "An\xe1lise ConfIA: N\xe3o executada";\n  if (analysis?.data) {\n    const stale = analysis.context.problem_id !== submission.problem_id || analysis.context.solution !== submission.solution;\n    renderReport(analysis.data, teacherCorrectionPanel, {\n      context: "teacher", analysis, stale, analyzeAgain: auditTeacherSubmission,\n    });\n    if (stale) teacherAnalysisStatus.textContent += " \xb7 resultado exibido de vers\xe3o anterior";\n    if (analysis.error) appendTextElement(teacherCorrectionPanel, "p", "validation-message", ANALYSIS_ERROR);\n  } else if (analysis?.pending) {\n    renderTeacherCorrectionEmpty(`Analisando o envio de ${submission.student_name || "Aluno"} com o ConfIA.`);\n  } else if (analysis?.error) {\n    renderError(ANALYSIS_ERROR, teacherCorrectionPanel);\n  } else {\n    renderTeacherCorrectionEmpty("An\xe1lise ConfIA ainda n\xe3o realizada para este envio.");\n  }\n}\n\nfunction renderSelectedSubmission() {\n  const submission = selectedTeacherSubmission;\n  if (!submission) {\n    teacherStudentName.textContent = "Selecione um envio";\n    teacherProblemTitle.textContent = "-";\n    teacherSubmissionStatus.textContent = "sem sele\xe7\xe3o";\n    teacherSubmissionStatus.dataset.kind = "neutral";\n    teacherSolution.textContent = "A solu\xe7\xe3o enviada aparecer\xe1 aqui.";\n    teacherAuditButton.disabled = true;\n    teacherAuditButton.setAttribute("aria-busy", "false");\n    teacherAnalysisStatus.textContent = "An\xe1lise ConfIA: falta selecionar um envio";\n    teacherAnalysisStatus.dataset.analysisState = "not-run";\n    teacherDecisionMessage.textContent = "";\n    renderTeacherCorrectionEmpty();\n    return;\n  }\n\n  teacherStudentName.textContent = submission.student_name || "Aluno";\n  teacherProblemTitle.textContent = submission.problem_title || currentProblemTitle(submission.problem_id);\n  teacherSubmissionStatus.textContent = "Demonstra\xe7\xe3o textual local";\n  teacherSubmissionStatus.dataset.kind = "neutral";\n  teacherSolution.textContent = submission.solution || "Solu\xe7\xe3o n\xe3o informada.";\n  renderTeacherAnalysis(submission);\n}\n\nfunction renderTeacherArea() {\n  const realSubmissions = readLocalSubmissions();\n  const visibleDemoSubmissions = realSubmissions.length === 0 ? demoSubmissions : [];\n  const allVisibleSubmissions = [...realSubmissions, ...visibleDemoSubmissions];\n\n  if (\n    selectedTeacherSubmission &&\n    !allVisibleSubmissions.some((submission) => submission.id === selectedTeacherSubmission.id)\n  ) {\n    selectedTeacherSubmission = null;\n  }\n\n  if (!selectedTeacherSubmission && allVisibleSubmissions.length > 0) {\n    selectedTeacherSubmission = allVisibleSubmissions[0];\n  }\n\n  renderSubmissionList(\n    realSubmissionList,\n    realSubmissions,\n    "Nenhum envio de demonstra\xe7\xe3o foi salvo neste navegador."\n  );\n  renderSubmissionList(\n    demoSubmissionList,\n    visibleDemoSubmissions,\n    realSubmissions.length > 0\n      ? "Exemplos demonstrativos ficam ocultos quando h\xe1 registros locais neste navegador."\n      : "Use estes exemplos enquanto n\xe3o houver registros locais."\n  );\n  renderSelectedSubmission();\n}\n\nfunction submitSolutionToTeacher() {\n  const problem = selectedProblem();\n  const solution = solutionInput.value.trim();\n  const studentName = studentNameInput.value.trim();\n  clearStudentValidation();\n\n  if (!problem) {\n    studentValidation(problemSelect, "Selecione uma quest\xe3o antes de salvar o registro de demonstra\xe7\xe3o.");\n    return;\n  }\n  if (!studentName) {\n    studentValidation(studentNameInput, "Informe o nome do aluno antes de salvar o registro de demonstra\xe7\xe3o.");\n    return;\n  }\n  if (!solution) {\n    studentValidation(solutionInput, "Digite ou cole uma solu\xe7\xe3o antes de salvar o registro de demonstra\xe7\xe3o.");\n    return;\n  }\n\n  const problemId = problem.problem_id || problem.id;\n  const submission = {\n    id: `sub_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`,\n    student_name: studentName,\n    problem_id: problemId,\n    problem_title: problem.title || problemId,\n    solution,\n    submitted_at: new Date().toISOString(),\n    status: "pendente",\n  };\n  const submissions = readLocalSubmissions();\n  submissions.unshift(submission);\n  writeLocalSubmissions(submissions);\n  selectedTeacherSubmission = { ...submission, source: "real" };\n  renderTeacherArea();\n  setStatus("Registro salvo neste navegador", "success");\n  if (typeof window !== "undefined") window.ConfIAShell?.refreshLocalSubmissions?.();\n  renderStudentSubmitInfo(\n    "Registro salvo neste navegador. Este modo de demonstra\xe7\xe3o ainda n\xe3o envia a solu\xe7\xe3o ao servidor."\n  );\n}\n\nasync function loadProblems() {\n  setStatus("Carregando", "busy");\n  const response = await fetch("/problems");\n  if (!response.ok) {\n    throw new Error("N\xe3o foi poss\xedvel carregar as quest\xf5es.");\n  }\n  problems = await response.json();\n  problemCatalogState = "ready";\n  renderProblems();\n  renderTeacherArea();\n  if (typeof window !== "undefined") window.ConfIAWorkspace?.catalogReady();\n  setStatus("Pronto", "idle");\n}\n\nasync function loadSelectedExample() {\n  const problemId = problemSelect.value;\n  const exampleKey = exampleSelect.value;\n  const version = studentVersion;\n  const sequence = ++exampleSequence;\n  examplePending = true;\n  loadExampleButton.disabled = true;\n  loadExampleButton.setAttribute("aria-busy", "true");\n  setStatus("Carregando exemplo", "busy");\n  try {\n    const response = await fetch(`/problems/${problemId}/examples/${exampleKey}`);\n    if (!response.ok) throw new Error(`Exemplo: HTTP ${response.status}`);\n    const payload = await response.json();\n    if (sequence !== exampleSequence || version !== studentVersion || problemSelect.value !== problemId || exampleSelect.value !== exampleKey) {\n      setStatus("Exemplo n\xe3o aplicado: a sele\xe7\xe3o ou a solu\xe7\xe3o foi alterada", "idle");\n      return;\n    }\n    solutionInput.value = payload.solution || "";\n    studentContextChanged();\n    setStatus("Exemplo carregado", "idle");\n  } catch (error) {\n    console.error("ConfIA: carregamento de exemplo", error);\n    studentValidationMessage.textContent = "N\xe3o foi poss\xedvel carregar o exemplo selecionado. Tente novamente.";\n    setStatus("Exemplo indispon\xedvel", "error");\n  } finally {\n    if (sequence === exampleSequence) {\n      examplePending = false;\n      updateStudentAction();\n      loadExampleButton.setAttribute("aria-busy", "false");\n    }\n  }\n}\n\nasync function requestAnalysis(context) {\n  const response = await fetch("/audit", {\n    method: "POST",\n    headers: { "Content-Type": "application/json" },\n    body: JSON.stringify({ problem_id: context.problem_id, solution: context.solution }),\n  });\n  if (!response.ok) throw new Error(`An\xe1lise: HTTP ${response.status}: ${await response.text()}`);\n  const data = await response.json();\n  if (data.problem_id !== context.problem_id) throw new Error("A quest\xe3o retornada n\xe3o corresponde \xe0 quest\xe3o analisada.");\n  return data;\n}\n\nasync function auditCurrentSolution() {\n  if (studentAuditPending) return;\n  if (typeof window !== "undefined" && window.ConfIAWorkspace && !window.ConfIAWorkspace.canAnalyze()) return;\n  clearStudentValidation();\n  const context = Object.freeze({\n    problem_id: problemSelect.value,\n    solution: solutionInput.value.trim(),\n    version: studentVersion,\n    sequence: ++studentAuditSequence,\n    ...(typeof window !== "undefined" ? window.ConfIAWorkspace?.analysisContext() : {}),\n  });\n  if (!selectedProblem()) {\n    studentValidation(problemSelect, "Selecione uma quest\xe3o antes de analisar.");\n    return;\n  }\n  if (!context.solution) {\n    studentValidation(solutionInput, "Digite ou carregue uma solu\xe7\xe3o antes de analisar.");\n    return;\n  }\n  studentAuditContext = context;\n  const tutoring = typeof window !== "undefined" && window.ConfIAWorkspace?.experience === "TUTOR";\n  setBusy(true);\n  setStatus(tutoring ? `Preparando feedback para a quest\xe3o ${context.problem_id}` : `Analisando a quest\xe3o ${context.problem_id}`, "busy");\n  renderStudentAnalysis();\n  try {\n    const data = tutoring ? await window.ConfIATutoria.requestFeedback(context) : await requestAnalysis(context);\n    if (context.sequence !== studentAuditSequence) return;\n    if (typeof window !== "undefined" && window.ConfIAWorkspace) window.ConfIAWorkspace.recordAnalysis({ context, data });\n    else studentAnalysis = { context, data };\n    renderStudentAnalysis();\n    if (typeof window === "undefined" || !window.ConfIAWorkspace || window.ConfIAWorkspace.owns(context)) setStatus(tutoring ? `Feedback demonstrativo dispon\xedvel para a quest\xe3o ${context.problem_id}` : `An\xe1lise conclu\xedda para a quest\xe3o ${context.problem_id}`, "success");\n  } catch (error) {\n    console.error("ConfIA: an\xe1lise do aluno", context, error);\n    const currentContext = typeof window === "undefined" || !window.ConfIAWorkspace || window.ConfIAWorkspace.owns(context);\n    if (currentContext) {\n      studentValidationMessage.textContent = ANALYSIS_ERROR;\n      // Keep a previous report available if a retry fails.\n      if (!studentAnalysis && studentMode === "study") renderError(ANALYSIS_ERROR);\n    }\n    if (currentContext) setStatus(`An\xe1lise indispon\xedvel para a quest\xe3o ${context.problem_id}`, "error");\n  } finally {\n    setBusy(false);\n    if (studentAnalysis) renderStudentAnalysis();\n    if (typeof window !== "undefined") window.ConfIAShell?.refreshStudent();\n  }\n}\n\nasync function auditTeacherSubmission() {\n  const submission = selectedTeacherSubmission;\n  if (!submission) {\n    renderTeacherCorrectionEmpty("Selecione um envio antes de analisar.");\n    return;\n  }\n  if (teacherAnalyses.get(submission.id)?.pending) return;\n  const context = Object.freeze({\n    submission_id: submission.id,\n    problem_id: submission.problem_id,\n    solution: submission.solution,\n  });\n  const previous = teacherAnalyses.get(submission.id);\n  const analysis = { context: previous?.data ? previous.context : context, pending: true, data: previous?.data || null, error: null };\n  teacherAnalyses.set(submission.id, analysis);\n  renderSelectedSubmission();\n  setStatus(`Analisando o envio de ${submission.student_name || "Aluno"}`, "busy");\n  try {\n    const data = await requestAnalysis(context);\n    analysis.context = context;\n    analysis.data = data;\n    // The operation owns the original reference, never the current selection.\n    submission.analysis = { context, data };\n    setStatus(`An\xe1lise conclu\xedda para o envio de ${submission.student_name || "Aluno"}`, "success");\n  } catch (error) {\n    console.error("ConfIA: an\xe1lise do professor", context, error);\n    analysis.error = error;\n    setStatus(`An\xe1lise indispon\xedvel para o envio de ${submission.student_name || "Aluno"}`, "error");\n  } finally {\n    analysis.pending = false;\n    if (selectedTeacherSubmission?.id === context.submission_id) renderSelectedSubmission();\n  }\n}\n\nfunction handleStudentPrimaryAction() {\n  if (typeof window !== "undefined" && window.ConfIAWorkspace) { auditCurrentSolution(); return; }\n  if (studentMode === "submit") {\n    try {\n      submitSolutionToTeacher();\n    } catch (error) {\n      console.error("ConfIA: registro local", error);\n      studentValidationMessage.textContent = "N\xe3o foi poss\xedvel salvar o registro neste navegador. Tente novamente.";\n      setStatus("Registro local indispon\xedvel", "error");\n    }\n    return;\n  }\n  auditCurrentSolution();\n}\n\nproblemSelect.addEventListener("change", () => {\n  renderExamples();\n  renderProblemStatement();\n  if (typeof window !== "undefined") window.ConfIAWorkspace?.onProblemSelected();\n  studentContextChanged();\n});\nsolutionInput.addEventListener("input", studentContextChanged);\nstudentNameInput.addEventListener("input", clearStudentValidation);\nfor (const button of tabButtons) {\n  button.addEventListener("click", () => activateArea(button.dataset.tabTarget));\n}\nfor (const button of studentModeButtons) {\n  button.addEventListener("click", () => setStudentMode(button.dataset.studentMode));\n}\nloadExampleButton.addEventListener("click", loadSelectedExample);\nauditButton.addEventListener("click", handleStudentPrimaryAction);\nteacherAuditButton.addEventListener("click", auditTeacherSubmission);\n\nupdateStudentAction();\nloadProblems().catch((error) => {\n  problemCatalogState = "error";\n  console.error("ConfIA: carregamento de quest\xf5es", error);\n  renderError("N\xe3o foi poss\xedvel carregar as quest\xf5es. Atualize a p\xe1gina e tente novamente.");\n  setStatus("Quest\xf5es indispon\xedveis", "error");\n  if (typeof window !== "undefined") window.ConfIATutoria?.catalogChanged([], true);\n});\n\n(function teacherManuscripts() {\n  "use strict";\n  const inbox = document.querySelector("#manuscript-inbox");\n  const legacy = document.querySelector("#teacher-text-prototype");\n  const list = document.querySelector("#manuscript-list");\n  const queuePanel = document.querySelector("#manuscript-queue");\n  const detail = document.querySelector("#manuscript-detail");\n  const message = document.querySelector("#manuscript-message");\n  const showInk = document.querySelector("#show-manuscripts");\n  const showText = document.querySelector("#show-text-prototype");\n  const refreshButton = document.querySelector("#refresh-manuscripts");\n  const filter = document.querySelector("#transcription-filter");\n  const assessmentFilter = document.querySelector("#assessment-filter");\n  const problemFilter = document.querySelector("#assessment-problem-filter");\n  const queueTitle = document.querySelector("#manuscript-queue-title");\n  const queueNote = document.querySelector("#manuscript-queue-note");\n  let queue = [];\n  let queueLoaded = false;\n  let listSequence = 0;\n  let detailSequence = 0;\n  let segmentSequence = 0;\n  let activeEditor = null;\n  let activeDecision = null;\n  let activeSubmissionContext = null;\n  let selectedSchool = "";\n  let selectedClassroom = "";\n  let institutionalMode = false;\n  let contextSequence = 0;\n  const labels = { RECEIVED: "Recebida pelo ConfIA", DRAFT: "Rascunho da transcri\xe7\xe3o", NEEDS_REVIEW: "Aguardando confer\xeancia", ACCEPTED: "Transcri\xe7\xe3o conferida" };\n  const statusLabel = (status) => labels[status] || "Estado indispon\xedvel";\n  const validId = (id) => typeof id === "string" && /^sub_[0-9a-f]{32}$/.test(id);\n  const when = (value) => new Date(value).toLocaleString("pt-BR");\n\n  function node(tag, content) {\n    const value = document.createElement(tag);\n    if (content !== undefined) value.textContent = content;\n    return value;\n  }\n\n  function labeled(text, control) {\n    const label = node("label");\n    label.appendChild(node("span", text));\n    label.appendChild(control);\n    return label;\n  }\n\n  function option(value, text) {\n    const item = node("option", text);\n    item.value = value;\n    return item;\n  }\n\n  async function request(url, options = {}) {\n    const response = await fetch(url, { cache: "no-store", ...options });\n    if (!response.ok) {\n      let diagnostic = null;\n      try {\n        diagnostic = await response.json();\n      } catch (_error) {\n        // Keep the status available in the diagnostic log.\n      }\n      const error = new Error(`HTTP ${response.status}`);\n      error.status = response.status;\n      error.diagnostic = diagnostic;\n      throw error;\n    }\n    return response.json();\n  }\n\n  const auditErrors = {\n    TRANSCRIPTION_NOT_ACCEPTED: "A transcri\xe7\xe3o precisa ser conferida antes da an\xe1lise.",\n    SOURCE_INTEGRITY_MISMATCH: "A fonte desta an\xe1lise n\xe3o passou na verifica\xe7\xe3o de integridade.",\n    RESULT_INTEGRITY_MISMATCH: "N\xe3o foi poss\xedvel validar a integridade do resultado desta an\xe1lise.",\n    REPRODUCIBILITY_INTEGRITY_MISMATCH: "N\xe3o foi poss\xedvel validar os metadados desta an\xe1lise.",\n    REVISION_CONFLICT: "Existe uma revis\xe3o mais recente ou um aceite de outra revis\xe3o. Atualize a solu\xe7\xe3o.",\n    AUDIT_RUN_CONFLICT: "N\xe3o foi poss\xedvel recuperar esta an\xe1lise. Atualize a solu\xe7\xe3o ou execute uma nova an\xe1lise.",\n  };\n  const safeErrorCode = error => Object.hasOwn(auditErrors, error?.diagnostic?.error_code)\n    ? error.diagnostic.error_code : null;\n\n  function productError(error, action = "load") {\n    console.error("ConfIA: manuscritos/transcri\xe7\xe3o", action, error.status, safeErrorCode(error));\n    if (safeErrorCode(error)) return auditErrors[safeErrorCode(error)];\n    if (action === "audit" && error.status === 409) {\n      const diagnostic = String(error.diagnostic?.detail || "");\n      if (/metadados|manifesto/i.test(diagnostic)) return auditErrors.REPRODUCIBILITY_INTEGRITY_MISMATCH;\n      if (/integridade|arquivos originais/i.test(diagnostic)) return auditErrors.SOURCE_INTEGRITY_MISMATCH;\n      if (/transcri\xe7\xe3o.*conferida/i.test(diagnostic)) return auditErrors.TRANSCRIPTION_NOT_ACCEPTED;\n      if (/result_sha256/i.test(diagnostic)) return auditErrors.RESULT_INTEGRITY_MISMATCH;\n      return auditErrors.AUDIT_RUN_CONFLICT;\n    }\n    if (/integridade da revis\xe3o ou do aceite/i.test(JSON.stringify(error.diagnostic || {}))) {\n      return action === "audit" ? "A integridade da revis\xe3o ou do aceite est\xe1 divergente. A an\xe1lise foi bloqueada."\n        : "A integridade da revis\xe3o ou do aceite est\xe1 divergente. Reabra a solu\xe7\xe3o para conferir o hist\xf3rico.";\n    }\n    if (action === "audit") {\n      const diagnostic = JSON.stringify(error.diagnostic || {});\n      if (/arquivos originais/i.test(diagnostic)) return "Os arquivos originais desta solu\xe7\xe3o precisam ser conferidos.";\n      if (/transcri\xe7\xe3o.*conferida/i.test(diagnostic)) return "A transcri\xe7\xe3o precisa ser conferida antes da an\xe1lise.";\n      return "N\xe3o foi poss\xedvel concluir a An\xe1lise ConfIA.";\n    }\n    if (error.status === 404) return "N\xe3o foi poss\xedvel carregar esta solu\xe7\xe3o. Ela pode n\xe3o estar mais dispon\xedvel. Atualize a lista e tente novamente.";\n    if (error.status === 409) {\n      const diagnostic = JSON.stringify(error.diagnostic || {});\n      if (/integridade|artefato|integrity|hash|artifact|snapshot|png/i.test(diagnostic)) return "Os arquivos originais desta solu\xe7\xe3o precisam ser conferidos. Reabra a solu\xe7\xe3o e consulte a integridade dos arquivos.";\n      return "Existe uma revis\xe3o mais recente da transcri\xe7\xe3o. Salve uma c\xf3pia das suas altera\xe7\xf5es e reabra a solu\xe7\xe3o para conferir o hist\xf3rico.";\n    }\n    if (action === "recognize") return "N\xe3o foi poss\xedvel gerar a transcri\xe7\xe3o autom\xe1tica. Nenhuma transcri\xe7\xe3o criada. Tente novamente.";\n    if (action === "save") return "N\xe3o foi poss\xedvel salvar a transcri\xe7\xe3o agora. Suas altera\xe7\xf5es continuam nesta tela. Confira os campos e tente novamente.";\n    if (action === "accept") return "N\xe3o foi poss\xedvel registrar a confer\xeancia desta transcri\xe7\xe3o. Reabra e tente novamente.";\n    return "N\xe3o foi poss\xedvel consultar as solu\xe7\xf5es agora. Atualize a lista e tente novamente.";\n  }\n\n  function canLeaveEditor() {\n    if (activeDecision?.busy || activeDecision?.isDirty()) {\n      message.textContent = activeDecision.busy ? "Aguarde a opera\xe7\xe3o da decis\xe3o terminar."\n        : "Salve ou descarte as altera\xe7\xf5es da decis\xe3o antes de trocar o contexto.";\n      message.focus();\n      return false;\n    }\n    if (!activeEditor) return true;\n    if (activeEditor.busy) {\n      message.textContent = "Aguarde a opera\xe7\xe3o desta transcri\xe7\xe3o terminar antes de trocar o contexto.";\n      message.focus();\n      return false;\n    }\n    if (!activeEditor.isDirty()) return true;\n    message.textContent = "Altera\xe7\xf5es n\xe3o salvas. Salve uma nova revis\xe3o ou use \u201cDescartar altera\xe7\xf5es n\xe3o salvas\u201d antes de trocar o contexto.";\n    message.focus();\n    return false;\n  }\n\n  function write(url, body) {\n    return request(url, {\n      method: "POST",\n      headers: { "Content-Type": "application/json" },\n      body: JSON.stringify(body),\n    });\n  }\n\n  function integrityDetails(data, id) {\n    const record = data.submission;\n    const hashes = node("details");\n    hashes.className = "disclosure";\n    hashes.appendChild(node("summary", "Integridade dos arquivos"));\n    hashes.appendChild(node("p", "Hashes indicam somente integridade t\xe9cnica; n\xe3o comprovam autoria nem validade matem\xe1tica."));\n    const items = node("ul");\n    for (const artifact of data.integrity) {\n      items.appendChild(node("li", `${artifact.filename}: ${artifact.matches ? "confere" : "divergente/ausente"} \xb7 SHA-256 esperado: ${artifact.expected_sha256} \xb7 atual: ${artifact.actual_sha256 || "ausente"}`));\n    }\n    hashes.appendChild(items);\n    const download = node("a", "Baixar vers\xe3o preparada original (JSON)");\n    download.href = `/submissions/${id}/snapshot`;\n    hashes.appendChild(download);\n    return hashes;\n  }\n\n  function originalsIntact(data) {\n    const expected = ["snapshot.json", ...data.submission.page_images.map(page => page.filename)];\n    return data.integrity.length === expected.length && expected.every(filename =>\n      data.integrity.some(item => item.filename === filename && item.matches));\n  }\n\n  function renderOriginal(panel, data, id) {\n    const record = data.submission;\n    const pages = [...record.page_images].sort((a, b) => a.page_index - b.page_index);\n    let current = 0;\n    panel.setAttribute("aria-label", "Solu\xe7\xe3o do aluno \u2014 manuscrito original");\n    panel.appendChild(node("h3", "Manuscrito original"));\n    panel.appendChild(node("p", "Solu\xe7\xe3o enviada pelo aluno."));\n    const integrity = node("p", originalsIntact(data) ? "\u2713 Arquivos originais conferidos e preservados." : "! Os arquivos originais desta solu\xe7\xe3o precisam ser conferidos.");\n    integrity.className = "alert";\n    integrity.dataset.kind = originalsIntact(data) ? "success" : "warning";\n    if (!originalsIntact(data)) panel.appendChild(integrity);\n    const navigation = node("div");\n    navigation.className = "page-navigation";\n    const previous = node("button", "P\xe1gina anterior");\n    previous.type = "button";\n    previous.className = "secondary-action";\n    const pageLabel = node("span");\n    pageLabel.setAttribute("role", "status");\n    pageLabel.setAttribute("aria-live", "polite");\n    const next = node("button", "Pr\xf3xima p\xe1gina");\n    next.type = "button";\n    next.className = "secondary-action";\n    navigation.appendChild(previous);\n    navigation.appendChild(pageLabel);\n    navigation.appendChild(next);\n    panel.appendChild(navigation);\n    const pageHost = node("div");\n    panel.appendChild(pageHost);\n\n    function draw() {\n      pageHost.replaceChildren();\n      const page = pages[current];\n      if (!page || !Number.isInteger(page.page_index) || page.page_index < 0 || page.page_index > 2) {\n        pageHost.appendChild(node("p", "\xcdndice de p\xe1gina inv\xe1lido."));\n        return;\n      }\n      pageLabel.textContent = `P\xe1gina ${current + 1} de ${pages.length}`;\n      previous.disabled = current === 0;\n      next.disabled = current === pages.length - 1;\n      const figure = node("figure");\n      figure.appendChild(node("figcaption", `P\xe1gina ${page.page_index + 1} \xb7 PNG original recebido`));\n      const integrity = data.integrity.find((item) => item.filename === page.filename);\n      if (integrity?.matches) {\n        const image = node("img");\n        image.alt = `Manuscrito original da quest\xe3o ${record.problem_id}, p\xe1gina ${page.page_index + 1}`;\n        image.src = `/submissions/${id}/pages/${page.page_index}`;\n        image.addEventListener("error", () => {\n          image.hidden = true;\n          const warning = node("p", "N\xe3o foi poss\xedvel carregar esta p\xe1gina. Atualize a consulta para conferir os arquivos originais.");\n          warning.setAttribute("role", "status");\n          figure.appendChild(warning);\n        });\n        figure.appendChild(image);\n      } else {\n        figure.appendChild(node("p", "Esta p\xe1gina est\xe1 indispon\xedvel. Os arquivos originais precisam ser conferidos."));\n      }\n      pageHost.appendChild(figure);\n    }\n    previous.addEventListener("click", () => { if (current > 0) { current -= 1; draw(); } });\n    next.addEventListener("click", () => { if (current + 1 < pages.length) { current += 1; draw(); } });\n    draw();\n    const evidence = integrityDetails(data, id);\n    if (originalsIntact(data)) evidence.appendChild(integrity);\n    panel.appendChild(evidence);\n  }\n\n  const orderedSegments = segments => [...segments].sort((a, b) => a.page_index - b.page_index || a.order - b.order);\n\n  function transcriptionSource(segment) {\n    // One representation per segment, shared by the reading page and source editor.\n    // Mathpix latex_styled is persisted as latex; text is its fallback, never an appendix.\n    // Distinct, complementary segments retain their own position in the document.\n    const hasLatex = typeof segment.latex === "string" && Boolean(segment.latex.trim());\n    const source = hasLatex ? segment.latex : segment.text || "";\n    const bareMath = hasLatex || segment.kind === "math"\n      || /^\\s*\\\\(?:frac|sqrt|sum|int|lim|left|begin)\\b/.test(source);\n    const parts = globalThis.ConfiaRecognitionView.splitMathText(source, bareMath);\n    // Add source delimiters only for an undelimited formula. Stored strings stay intact.\n    return parts.length === 1 && parts[0].math && parts[0].value === source.trim()\n      ? `\\\\[${source}\\\\]` : source;\n  }\n\n  function renderTranscriptionContent(host, segments) {\n    host.replaceChildren();\n    const document = node("div");\n    document.className = "transcription-document";\n    document.setAttribute("role", "document");\n    document.setAttribute("aria-label", "Transcri\xe7\xe3o reconhecida");\n    const view = globalThis.ConfiaRecognitionView;\n    let count = 0;\n    for (const segment of orderedSegments(segments)) {\n      const source = transcriptionSource(segment);\n      if (!source) continue;\n      const content = node("div");\n      content.className = "transcription-document-segment";\n      view.renderMathText(content, source);\n      document.appendChild(content);\n      count++;\n    }\n    if (!count) document.appendChild(node("p", "Nenhuma transcri\xe7\xe3o dispon\xedvel."));\n    host.appendChild(document);\n  }\n\n  function renderHistory(panel, history) {\n    const disclosure = node("details");\n    disclosure.className = "transcription-history";\n    disclosure.appendChild(node("summary", `Hist\xf3rico da transcri\xe7\xe3o (${history.revisions.length} ${history.revisions.length === 1 ? "revis\xe3o" : "revis\xf5es"})`));\n    for (const revision of [...history.revisions].reverse()) {\n      const article = node("article");\n      article.appendChild(node("h4", `Revis\xe3o ${revision.revision_number} \xb7 ${statusLabel(revision.status)}`));\n      const origin = revision.source === "automatic" && revision.change_type === "initial_transcription" ? "Autom\xe1tica" : "Manual";\n      article.appendChild(node("p", `${when(revision.created_at)} \xb7 ${origin}`));\n      const content = node("details");\n      content.appendChild(node("summary", "Ver revis\xe3o"));\n      if (revision.change_reason) content.appendChild(node("p", `Motivo: ${revision.change_reason}`));\n      const items = node("div");\n      renderTranscriptionContent(items, revision.segments);\n      content.appendChild(items);\n      const technical = node("details");\n      technical.appendChild(node("summary", "Detalhes t\xe9cnicos da revis\xe3o"));\n      technical.appendChild(node("pre", JSON.stringify(revision, null, 2)));\n      content.appendChild(technical);\n      article.appendChild(content);\n      disclosure.appendChild(article);\n    }\n    for (const acceptance of history.acceptances || []) {\n      disclosure.appendChild(node("p", `Confer\xeancia da revis\xe3o ${acceptance.revision_number} \xb7 ${when(acceptance.accepted_at)} \xb7 revisor n\xe3o verificado: ${acceptance.reviewer_reference}`));\n      if (acceptance.acceptance_note) disclosure.appendChild(node("p", acceptance.acceptance_note));\n    }\n    panel.appendChild(disclosure);\n  }\n\n  function renderTranscription(panel, data, id, history, providers) {\n    const pageCount = data.submission.page_images.length;\n    const latest = history?.revisions?.[history.revisions.length - 1] || null;\n    panel.setAttribute("aria-label", "Transcri\xe7\xe3o da solu\xe7\xe3o");\n    panel.appendChild(node("h3", "Transcri\xe7\xe3o reconhecida"));\n    const visual = node("div");\n    visual.className = "transcription-visual";\n    panel.appendChild(visual);\n    const revisionStatus = node("p", latest ? latest.status === "ACCEPTED" ? "Transcri\xe7\xe3o conferida" : "Transcri\xe7\xe3o a conferir" : "Transcri\xe7\xe3o: ainda n\xe3o criada");\n    revisionStatus.className = "transcription-status status";\n    revisionStatus.dataset.kind = latest?.status === "ACCEPTED" ? "success" : "pending";\n    const supportingDetails = node("div");\n    if (latest?.recognizer_run_id) {\n      const origin = node("details");\n      origin.appendChild(node("summary", `Detalhes do reconhecimento${latest.provider === "fake_test" ? " \u2014 teste artificial" : ""}`));\n      if (latest.provider === "fake_test") origin.appendChild(node("p", "Transcri\xe7\xe3o de teste artificial. Conte\xfado constante; n\xe3o \xe9 OCR real. Confira cada segmento com o original."));\n      origin.appendChild(node("p", `Origem autom\xe1tica \xb7 provider: ${latest.provider} \xb7 execu\xe7\xe3o: ${latest.recognizer_run_id} \xb7 adapter: ${latest.recognizer} ${latest.recognizer_version}`));\n      origin.appendChild(node("p", "Proveni\xeancia do reconhecimento do manuscrito"));\n      origin.appendChild(node("pre", JSON.stringify(latest.provenance || history.transcription.provenance || {}, null, 2)));\n      supportingDetails.appendChild(origin);\n    }\n    const recognition = node("details");\n    recognition.className = "recognition-assistance disclosure";\n    recognition.appendChild(node("summary", "Auxiliar de transcri\xe7\xe3o \u2014 teste artificial"));\n    const generateButtons = [];\n    // The only current adapter is explicitly artificial and gated by the server.\n    for (const provider of providers.filter(item => item.provider === "fake_test")) {\n      const generate = node("button", `Gerar transcri\xe7\xe3o autom\xe1tica \u2014 ${provider.label} (artificial)`);\n      generate.type = "button";\n      generate.className = "secondary-action";\n      generate.disabled = !originalsIntact(data);\n      generateButtons.push(generate);\n      recognition.appendChild(node("p", "Dispon\xedvel em desenvolvimento/teste. Produz conte\xfado artificial constante; n\xe3o \xe9 OCR real."));\n      recognition.appendChild(generate);\n      const recognitionMessage = node("p");\n      recognitionMessage.setAttribute("role", "status");\n      recognition.appendChild(recognitionMessage);\n      // Keep the same key across a failed transport/retry of this user action.\n      const key = `teacher:${Date.now()}:${++segmentSequence}`;\n      generate.addEventListener("click", async () => {\n        if (editor.busy || !canLeaveEditor()) return;\n        setEditorBusy(true);\n        generate.setAttribute("aria-busy", "true");\n        recognitionMessage.textContent = "Gerando transcri\xe7\xe3o autom\xe1tica de teste\u2026";\n        try {\n          const run = await write(`/submissions/${id}/recognitions`, { provider: provider.provider, idempotency_key: key });\n          if (run.status === "FAILED") {\n            const error = new Error("Reconhecedor indispon\xedvel");\n            error.diagnostic = run;\n            throw error;\n          }\n          recognitionMessage.textContent = "Transcri\xe7\xe3o criada. Aguardando confer\xeancia humana.";\n          setEditorBusy(false);\n          await open(id, run.transcription_id);\n        } catch (error) {\n          recognitionMessage.textContent = productError(error, "recognize");\n        } finally {\n          setEditorBusy(false);\n          generate.setAttribute("aria-busy", "false");\n        }\n      });\n    }\n    if (generateButtons.length) supportingDetails.appendChild(recognition);\n    const editing = node("div");\n    editing.className = "transcription-editor";\n    editing.hidden = true;\n    editing.id = `transcription-editor-${++segmentSequence}`;\n    editing.appendChild(node("h4", "Editar transcri\xe7\xe3o"));\n    const edit = node("button", "Editar transcri\xe7\xe3o");\n    edit.type = "button";\n    edit.className = "secondary-action";\n    edit.setAttribute("aria-controls", editing.id);\n    edit.setAttribute("aria-expanded", "false");\n    function showEditor(visible) {\n      editing.hidden = !visible;\n      visual.hidden = visible;\n      actions.hidden = visible;\n      edit.setAttribute("aria-expanded", String(visible));\n      if (visible) {\n        editorMessage.textContent = "";\n        sourceEditor.focus();\n      }\n    }\n    edit.addEventListener("click", () => { if (!editor.busy) showEditor(true); });\n    const initialSegments = latest?.segments || [];\n    const drafts = Array.from({ length: pageCount }, (_, pageIndex) => {\n      const segments = orderedSegments(initialSegments.filter(segment => segment.page_index === pageIndex));\n      // Textareas normalize line endings. Compare their normalized projection, but\n      // send the untouched original segments when a page\'s source was not edited.\n      const initial = segments.map(transcriptionSource).join("\\n\\n").replace(/\\r\\n?/g, "\\n");\n      return { pageIndex, segments, initial, source: initial };\n    });\n    let selectedPage = 0;\n    const pageSelect = node("select");\n    pageSelect.className = "transcription-source-page";\n    for (const draft of drafts) pageSelect.appendChild(option(String(draft.pageIndex), `P\xe1gina ${draft.pageIndex + 1}`));\n    pageSelect.value = "0";\n    if (pageCount > 1) editing.appendChild(labeled("P\xe1gina da transcri\xe7\xe3o", pageSelect));\n    const sourceEditor = node("textarea");\n    sourceEditor.className = "transcription-source";\n    sourceEditor.rows = 16;\n    sourceEditor.spellcheck = false;\n    sourceEditor.placeholder = "Texto-fonte com matem\xe1tica entre delimitadores LaTeX";\n    sourceEditor.value = drafts[selectedPage].source;\n    editing.appendChild(labeled("Texto-fonte da transcri\xe7\xe3o", sourceEditor));\n    pageSelect.addEventListener("change", () => {\n      if (editor.busy) return;\n      selectedPage = Number(pageSelect.value);\n      sourceEditor.value = drafts[selectedPage].source;\n    });\n    sourceEditor.addEventListener("input", () => {\n      if (editor.busy) return;\n      drafts[selectedPage].source = sourceEditor.value;\n      updateDirty();\n    });\n    function collectSegments() {\n      return drafts.flatMap(draft => {\n        if (draft.source === draft.initial && draft.segments.length) return draft.segments;\n        if (!draft.source && drafts.some(page => page.source)) return [];\n        // A manual page has one source. Do not carry an obsolete alternate latex\n        // field or measured segment coordinates into the newly edited document.\n        return [{ segment_id: `manual:${Date.now()}:${++segmentSequence}`, page_index: draft.pageIndex,\n          order: 0, kind: "mixed", text: draft.source || null, latex: null }];\n      });\n    }\n    const reviewer = node("input");\n    reviewer.type = "text";\n    reviewer.maxLength = 80;\n    reviewer.value = latest?.reviewer_reference === "automatic:pending-human-review" ? "professor-teste-01" : latest?.reviewer_reference || "professor-teste-01";\n    editing.appendChild(labeled("Refer\xeancia do revisor (identidade n\xe3o verificada)", reviewer));\n    const reason = node("input");\n    reason.type = "text";\n    reason.maxLength = 500;\n    reason.placeholder = "Ex.: corrige palavra lida incorretamente";\n    editing.appendChild(labeled("Motivo da nova revis\xe3o (opcional)", reason));\n    panel.appendChild(editing);\n    const actions = node("div");\n    actions.className = "transcription-actions";\n    const save = node("button", "Salvar nova vers\xe3o");\n    save.type = "button";\n    save.className = "primary-action";\n    const accept = node("button", "Conferir transcri\xe7\xe3o");\n    accept.type = "button";\n    accept.className = "secondary-action";\n    const fidelityHelp = "Conferir confirma somente a fidelidade ao manuscrito; n\xe3o significa solu\xe7\xe3o correta nem avalia\xe7\xe3o do professor.";\n    accept.setAttribute("aria-description", fidelityHelp);\n    accept.disabled = !latest || latest.status === "ACCEPTED";\n    const discard = node("button", "Cancelar");\n    discard.type = "button";\n    discard.className = "secondary-action";\n    const editActions = node("div");\n    editActions.className = "transcription-actions";\n    editActions.appendChild(discard);\n    editActions.appendChild(save);\n    editing.appendChild(editActions);\n    actions.appendChild(edit);\n    actions.appendChild(accept);\n    panel.appendChild(actions);\n    panel.appendChild(revisionStatus);\n    const dirtyMessage = node("p");\n    dirtyMessage.className = "transcription-dirty-message";\n    dirtyMessage.setAttribute("role", "status");\n    dirtyMessage.setAttribute("aria-live", "polite");\n    panel.appendChild(dirtyMessage);\n    const editorMessage = node("p");\n    editorMessage.className = "transcription-message";\n    editorMessage.setAttribute("role", "status");\n    editorMessage.setAttribute("aria-live", "polite");\n    editorMessage.id = `transcription-error-${++segmentSequence}`;\n    reviewer.setAttribute("aria-describedby", editorMessage.id);\n    panel.appendChild(editorMessage);\n    const initialReviewer = reviewer.value;\n    const fingerprint = () => JSON.stringify({\n      reviewer: reviewer.value, reason: reason.value,\n      pages: drafts.map(draft => draft.source),\n    });\n    let baseline = fingerprint();\n    const editor = {\n      busy: false,\n      isDirty: () => fingerprint() !== baseline,\n      discard: () => {\n        reviewer.value = initialReviewer;\n        reviewer.setAttribute("aria-invalid", "false");\n        reason.value = "";\n        for (const draft of drafts) draft.source = draft.initial;\n        sourceEditor.value = drafts[selectedPage].source;\n        baseline = fingerprint();\n        editorMessage.textContent = "Altera\xe7\xf5es descartadas. A revis\xe3o persistida permanece dispon\xedvel.";\n        updateDirty();\n        showEditor(false);\n        edit.focus();\n      },\n    };\n    activeEditor = editor;\n\n    function updateDirty() {\n      const dirty = editor.isDirty();\n      dirtyMessage.textContent = dirty ? "Altera\xe7\xf5es n\xe3o salvas. Salve uma nova revis\xe3o antes de conferir a transcri\xe7\xe3o." : "";\n      dirtyMessage.hidden = !dirty;\n      dirtyMessage.dataset.dirty = String(dirty);\n      accept.disabled = editor.busy || dirty || !latest || latest.status === "ACCEPTED";\n      accept.title = dirty ? "Salve ou descarte as altera\xe7\xf5es antes de conferir a revis\xe3o persistida." : fidelityHelp;\n      discard.disabled = editor.busy;\n      editor.onChange?.();\n    }\n\n    function setEditorBusy(busy) {\n      editor.busy = busy;\n      for (const control of [reviewer, reason, save, edit, sourceEditor, pageSelect, ...generateButtons]) {\n        control.disabled = busy;\n      }\n      for (const button of generateButtons) button.disabled = busy || !originalsIntact(data);\n      updateDirty();\n    }\n    editor.setBusy = setEditorBusy;\n\n    function validateReviewer() {\n      const invalid = !reviewer.value.trim();\n      reviewer.setAttribute("aria-invalid", String(invalid));\n      if (invalid) {\n        editorMessage.textContent = "Informe uma refer\xeancia para o revisor antes de continuar.";\n        reviewer.focus();\n      }\n      return !invalid;\n    }\n\n    reviewer.addEventListener("input", () => { reviewer.setAttribute("aria-invalid", "false"); updateDirty(); });\n    reason.addEventListener("input", updateDirty);\n    discard.addEventListener("click", () => { if (!editor.busy) editor.discard(); });\n    renderTranscriptionContent(visual, initialSegments);\n    updateDirty();\n    save.addEventListener("click", async () => {\n      if (editor.busy || !validateReviewer()) return;\n      const tooLong = drafts.find(draft => draft.source !== draft.initial && draft.source.length > 20000);\n      if (tooLong) {\n        editorMessage.textContent = `A p\xe1gina ${tooLong.pageIndex + 1} excede o limite de 20.000 caracteres para uma edi\xe7\xe3o. O texto ainda n\xe3o foi salvo.`;\n        return;\n      }\n      setEditorBusy(true);\n      save.setAttribute("aria-busy", "true");\n      editorMessage.textContent = latest ? "Salvando nova revis\xe3o sem alterar a anterior\u2026" : "Criando transcri\xe7\xe3o manual\u2026";\n      try {\n        const common = { reviewer_reference: reviewer.value.trim(), reviewer_identity_verified: false, segments: collectSegments(), status: "NEEDS_REVIEW" };\n        if (latest) {\n          await write(`/transcriptions/${history.transcription.transcription_id}/revisions`, {\n            ...common, based_on_revision_number: latest.revision_number, change_type: "reading_correction",\n            ...(reason.value.trim() ? { change_reason: reason.value.trim() } : {}),\n          });\n        } else {\n          await write(`/submissions/${id}/transcriptions`, { ...common, source: "manual", recognizer: null, recognizer_version: null });\n        }\n        baseline = fingerprint();\n        editorMessage.textContent = "Revis\xe3o salva. Atualizando hist\xf3rico\u2026";\n        setEditorBusy(false);\n        await open(id, history?.transcription.transcription_id);\n        if (!detail.hidden) message.textContent = "Transcri\xe7\xe3o salva. A nova vers\xe3o aguarda confer\xeancia.";\n      } catch (error) {\n        editorMessage.textCon